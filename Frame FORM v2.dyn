    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\nfrom io import StringIO\r\nsys.stdout = StringIO()\r\nimport os\r\n\r\nsupports= IN[1]\r\n\r\n\r\n\r\n# Adding the site-packages directory to sys.path\r\nlocalapp = os.getenv('LOCALAPPDATA')\r\nsite_packages_path = os.path.join(localapp, 'python-3.9.12-embed-amd64', 'Lib', 'site-packages')\r\nsys.path.append(site_packages_path)\r\n\r\nfrom pymoo.core.problem import Problem\r\nfrom pymoo.operators.sampling.rnd import IntegerRandomSampling\r\nfrom pymoo.optimize import minimize\r\nfrom pymoo.config import Config\r\nfrom pymoo.algorithms.soo.nonconvex.de import DE\r\nfrom pymoo.optimize import minimize\r\nimport pystra as ps\r\nimport numpy as np\r\nimport time\r\nfrom PyNite import FEModel3D,Visualization\r\nimport pandas as pd\r\n\r\nstart_time = time.time()\r\n\r\n\r\n\r\ndef round_coords(x, y, z, precision=4):\r\n    return (round(x, precision), round(y, precision), round(z, precision))\r\n\r\ndef excel_call(list_of_numbers):\r\n\r\n    column_sections = IN[17]\r\n\r\n    beam_sections = IN[18]\r\n\r\n\r\n    # Load the Excel file outside the loop to avoid repeated loading\r\n    file_path = r'C:\\Users\\ugury\\OneDrive\\Masaüstü\\Programming\\FORM Pynite\\Frame\\section_properties.xlsx'\r\n    df = pd.read_excel(file_path)\r\n\r\n    # Lists to hold results for all sets of numbers\r\n    all_Iy_lists, all_Iz_lists, all_A_lists, all_J_lists, all_V_lists = [], [], [], [], []\r\n\r\n\r\n    for numbers in list_of_numbers:\r\n        colum_indexes = numbers[:4]\r\n\r\n        beams_indexes = numbers[4:]\r\n\r\n\r\n        selected_columns = [column_sections[i] for i in colum_indexes]\r\n        selected_beams = [beam_sections[i] for i in beams_indexes]\r\n        section_list = selected_columns + selected_beams\r\n\r\n        sections = section_list\r\n\r\n        Iy_list, Iz_list, A_list, J_list, V_list = [], [], [], [], []\r\n\r\n        for section in sections:\r\n            Iy = df.loc[df['Section Name'] == section, \"Iy[cm4]\"].values[0] if section in df['Section Name'].values else None\r\n            Iz = df.loc[df['Section Name'] == section, \"Iz[cm4]\"].values[0] if section in df['Section Name'].values else None\r\n            A = df.loc[df['Section Name'] == section, \"A[cm2]\"].values[0] if section in df['Section Name'].values else None\r\n            J = df.loc[df['Section Name'] == section, \"Ip[cm4]\"].values[0] if section in df['Section Name'].values else None\r\n            V = df.loc[df['Section Name'] == section, \"V[cm3/m]\"].values[0] if section in df['Section Name'].values else None\r\n\r\n            Iy_list.append(Iy)\r\n            Iz_list.append(Iz)\r\n            A_list.append(A)\r\n            J_list.append(J)\r\n            V_list.append(V)\r\n\r\n        # Convert units\r\n        Iy_list = [x * 1.0E-8 for x in Iy_list if x is not None]\r\n        Iz_list = [x * 1.0E-8 for x in Iz_list if x is not None]\r\n        A_list = [x * 1.0E-4 for x in A_list if x is not None]\r\n        J_list = [x * 1.0E-8 for x in J_list if x is not None]\r\n        V_list = [x * 1.0E-6 for x in V_list if x is not None]\r\n\r\n        # Append the lists of results to the corresponding overall lists\r\n        all_Iy_lists.append(Iy_list)\r\n        all_Iz_lists.append(Iz_list)\r\n        all_A_lists.append(A_list)\r\n        all_J_lists.append(J_list)\r\n        all_V_lists.append(V_list)\r\n\r\n    return all_Iy_lists, all_Iz_lists, all_A_lists, all_J_lists, all_V_lists\r\n\r\ndef volume_func(mean_V):\r\n\r\n\r\n    bars = IN[0]\r\n\r\n    \r\n    # Create a new finite element model\r\n    model = FEModel3D.FEModel3D()\r\n    \r\n    # Dictionary to map unique nodes to their assigned IDs\r\n    unique_nodes = {}\r\n    next_node_id = 1  # Start with the first ID for nodes\r\n    next_member_id = 1  # Start with the first ID for members\r\n\r\n    members = []  # This will hold the list of members as tuples\r\n    \r\n    # Assign an ID to each unique node and prepare to create members\r\n    for bar in bars:\r\n        start_key = round_coords(bar.StartPoint.X, bar.StartPoint.Z, bar.StartPoint.Y)\r\n        end_key = round_coords(bar.EndPoint.X, bar.EndPoint.Z, bar.EndPoint.Y)\r\n    \r\n        # Check and add the start node if unique\r\n        if start_key not in unique_nodes:\r\n            unique_nodes[start_key] = next_node_id\r\n            model.add_node(str(next_node_id), *start_key)\r\n            next_node_id += 1\r\n    \r\n        # Check and add the end node if unique\r\n        if end_key not in unique_nodes:\r\n            unique_nodes[end_key] = next_node_id\r\n            model.add_node(str(next_node_id), *end_key)\r\n            next_node_id += 1\r\n            \r\n        \r\n        # Create a member between start and end nodes\r\n        start_node_id = unique_nodes[start_key]\r\n        end_node_id = unique_nodes[end_key]\r\n        member_id = f\"M{next_member_id}\"\r\n        members.append((member_id, str(start_node_id), str(end_node_id)))\r\n        next_member_id += 1\r\n\r\n\r\n    # Define material (name, elastic modulus, poissons ratio, density)\r\n    E_current = IN[4] # (kN/m2) Modulus of elasticity\r\n    G = 76904120  # (kN/m2) Shear modulus\r\n    nu = 0.3  # Poisson's ratio\r\n    rho = 76.97  # (kN/m3) Density\r\n    model.add_material('Steel', E_current, G, nu, rho)\r\n\r\n\r\n    V_list = mean_V\r\n    V_list = [V_list[0]] * 2 + [V_list[1]] + [V_list[2]] * 2 + [V_list[3]] + [V_list[2]] * 2 + [V_list[3]] + [V_list[0]] * 2 + [V_list[1]] + [V_list[4]] * 6 + [V_list[5]] * 3\r\n\r\n\r\n\r\n\r\n\r\n    # Create the model and add members with their respective properties\r\n    for i, member in enumerate(members):\r\n        name, node_i, node_j = member\r\n        model.add_member(name, node_i, node_j,'Steel')\r\n\r\n\r\n    # Calculate and print the volume of the structure\r\n    total_volume = 0.0\r\n    for i, member_name in enumerate(model.Members):\r\n        V = V_list[i]\r\n        L = model.Members[member_name].L()\r\n        volume = V * L \r\n        total_volume += volume\r\n\r\n\r\n    return total_volume\r\n    \r\n    \r\n\r\ndef myfunction(P1,P2,P3, E,Wd, X0,X1,X2,X3,X4,X5,I0,I1,I2,I3,I4,I5, mean_Iy, mean_Ij):\r\n\r\n    displacement_list = []\r\n    for k in range(len(E)):\r\n\r\n        # INPUTS\r\n\r\n        bars = IN[0]\r\n        \r\n        # Create a new finite element model\r\n        model = FEModel3D.FEModel3D()\r\n        \r\n        # Dictionary to map unique nodes to their assigned IDs\r\n        unique_nodes = {}\r\n        next_node_id = 1  # Start with the first ID for nodes\r\n        next_member_id = 1  # Start with the first ID for members\r\n    \r\n        members = []  # This will hold the list of members as tuples\r\n        \r\n        # Assign an ID to each unique node and prepare to create members\r\n        for bar in bars:\r\n            start_key = round_coords(bar.StartPoint.X, bar.StartPoint.Z, bar.StartPoint.Y)\r\n            end_key = round_coords(bar.EndPoint.X, bar.EndPoint.Z, bar.EndPoint.Y)\r\n        \r\n            # Check and add the start node if unique\r\n            if start_key not in unique_nodes:\r\n                unique_nodes[start_key] = next_node_id\r\n                model.add_node(str(next_node_id), *start_key)\r\n                next_node_id += 1\r\n        \r\n            # Check and add the end node if unique\r\n            if end_key not in unique_nodes:\r\n                unique_nodes[end_key] = next_node_id\r\n                model.add_node(str(next_node_id), *end_key)\r\n                next_node_id += 1\r\n            \r\n            # Create a member between start and end nodes\r\n            start_node_id = unique_nodes[start_key]\r\n            end_node_id = unique_nodes[end_key]\r\n            member_id = f\"M{next_member_id}\"\r\n            members.append((member_id, str(start_node_id), str(end_node_id)))\r\n            next_member_id += 1\r\n\r\n        # Define supports (node, x_restraint, y_restraint, z_restraint, x_rotation_restraint, y_rotation_restraint, z_rotation_restraint)\r\n        for element in supports:\r\n        \r\n            model.def_support(f'{element}', True, True, True, True, True, True)\r\n\r\n\r\n        # Define material (name, elastic modulus, poissons ratio, density)\r\n        E_current = E[k]  # (kN/m2) Modulus of elasticity\r\n        G = 76904120  # (kN/m2) Shear modulus\r\n        nu = 0.3  # Poisson's ratio\r\n        rho = IN[5]  # (kN/m3) Density\r\n        model.add_material('Steel', E_current, G, nu, rho)\r\n\r\n        Iy_list = mean_Iy   \r\n        J_list = mean_Ij  \r\n\r\n        A_list=[X0[k],X1[k],X2[k],X3[k],X4[k],X5[k]]\r\n        Iz_list=[I0[k],I1[k],I2[k],I3[k],I4[k],I5[k]]\r\n\r\n\r\n        # Define separate lists for Iy, Iz, and A\r\n        # Adjust the lists according to the pattern in section_names\r\n        J_list = [J_list[0]] * 2 + [J_list[1]] + [J_list[2]] * 2 + [J_list[3]] + [J_list[2]] * 2 + [J_list[3]] + [J_list[0]] * 2 + [J_list[1]] + [J_list[4]] * 6 + [J_list[5]] * 3\r\n        Iy_list = [Iy_list[0]] * 2 + [Iy_list[1]] + [Iy_list[2]] * 2 + [Iy_list[3]] + [Iy_list[2]] * 2 + [Iy_list[3]] + [Iy_list[0]] * 2 + [Iy_list[1]] + [Iy_list[4]] * 6 + [Iy_list[5]] * 3\r\n        Iz_list = [Iz_list[0]] * 2 + [Iz_list[1]] + [Iz_list[2]] * 2 + [Iz_list[3]] + [Iz_list[2]] * 2 + [Iz_list[3]] + [Iz_list[0]] * 2 + [Iz_list[1]] + [Iz_list[4]] * 6 + [Iz_list[5]] * 3\r\n        A_list = [A_list[0]] * 2 + [A_list[1]] + [A_list[2]] * 2 + [A_list[3]] + [A_list[2]] * 2 + [A_list[3]] + [A_list[0]] * 2 + [A_list[1]] + [A_list[4]] * 6 + [A_list[5]] * 3\r\n\r\n\r\n \r\n\r\n\r\n\r\n\r\n        # Create the model and add members with their respective properties\r\n        for i, member in enumerate(members):\r\n            name, node_i, node_j = member\r\n            Iy = Iz_list[i] # bcs of different coordinate system\r\n            Iz = Iy_list[i] # bcs of different coordinate system\r\n            A = A_list[i]\r\n            J = J_list[i]\r\n\r\n            model.add_member(name, node_i, node_j, 'Steel', Iy, Iz,J,A)\r\n\r\n        \r\n        Loads=IN[2]\r\n        # Add loads (kN)\r\n        model.add_node_load(f'{Loads[0]}', 'FX', P1[k]) \r\n        model.add_node_load(f'{Loads[1]}', 'FX',P2[k])\r\n        model.add_node_load(f'{Loads[2]}', 'FX',P3[k])\r\n\r\n        WD=Wd[k]\r\n        \r\n        Dist_Loads=IN[3]\r\n        # (kN/m)\r\n        \r\n        for element in Dist_Loads:\r\n            model.add_member_dist_load(f'M{element}', 'FY', -WD, -WD)\r\n        \r\n\r\n\r\n\r\n        # Analyze the model\r\n        model.analyze(check_statics=False, check_stability=True)\r\n\r\n\r\n\r\n\r\n        # Step 1: Initialize a dictionary to store displacements for each level\r\n        story_displacements = {}\r\n\r\n        # Step 2: Loop through all nodes to group nodes by their Y-coordinate (level height)\r\n        for node_id in model.Nodes:\r\n            node = model.Nodes[node_id]\r\n            y = node.Y  # Y-coordinate of the node (used to identify the level)\r\n            \r\n            # Initialize displacement list for the story if it doesn't exist yet\r\n            if y not in story_displacements:\r\n                story_displacements[y] = {'dx': [], 'dy': [], 'dz': []}\r\n            \r\n            # Step 3: Retrieve displacements for each node\r\n            dx = node.DX['Combo 1']  # Displacement in X direction\r\n\r\n            \r\n            # Step 4: Append the displacements to the corresponding story (Y-level)\r\n            story_displacements[y]['dx'].append(dx)\r\n            \r\n\r\n\r\n        max_story_displacements=[]\r\n\r\n        # Step 5: Now you have displacement lists for each story (Y level)\r\n        for level, displacements in story_displacements.items():\r\n            max_dx = max(displacements['dx'], default=0)\r\n            max_story_displacements.append(max_dx)\r\n\r\n\r\n\r\n        displacement_list.append(max_story_displacements[1:])\r\n\r\n        #Visualization.render_model(model, annotation_size=0.5, deformed_shape=False, deformed_scale=1)\r\n\r\n    return displacement_list\r\n    \r\n\r\n\r\n\r\n\r\n#region FORM SECTION\r\ndef FORM(mean_A_list, mean_Iz_list, mean_Iy_list, mean_J_list):   \r\n\r\n    disp_lim=IN[6]\r\n    beta_allowable = IN[7] # Allowable reliability indices for each floor\r\n\r\n    def limit_state_function1(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5):\r\n\r\n        # Directly use mean_Iy_list, mean_J_list, mean_V_list from the enclosing scope\r\n        func_result = myfunction(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5,mean_Iy_list,mean_J_list)\r\n        # print(\"func_result\", func_result)\r\n\r\n\r\n        displacements = func_result\r\n\r\n        # Define lists for each floor's displacements\r\n        first_floor_displacements = []\r\n        second_floor_displacements = []\r\n        third_floor_displacements = []\r\n\r\n        # Iterate through the displacement sublists and extract displacements for each floor\r\n        for displacement in displacements:\r\n            first_floor_displacements.append(displacement[0])\r\n            second_floor_displacements.append(displacement[1])\r\n            third_floor_displacements.append(displacement[2])\r\n\r\n        Displacement = np.array(first_floor_displacements)\r\n\r\n        # Return all constraints in an array\r\n        return disp_lim - abs(Displacement)\r\n    \r\n    def limit_state_function2(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5):\r\n\r\n        # Directly use mean_Iy_list, mean_J_list, mean_V_list from the enclosing scope\r\n        func_result = myfunction(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5,mean_Iy_list,mean_J_list)\r\n\r\n\r\n\r\n        displacements = func_result\r\n\r\n        # Define lists for each floor's displacements\r\n        first_floor_displacements = []\r\n        second_floor_displacements = []\r\n        third_floor_displacements = []\r\n\r\n        # Iterate through the displacement sublists and extract displacements for each floor\r\n        for displacement in displacements:\r\n            first_floor_displacements.append(displacement[0])\r\n            second_floor_displacements.append(displacement[1])\r\n            third_floor_displacements.append(displacement[2])\r\n\r\n\r\n        # Return all constraints in an array\r\n        return disp_lim - abs(np.array(second_floor_displacements)-np.array(first_floor_displacements))\r\n    def limit_state_function3(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5):\r\n\r\n        # Directly use mean_Iy_list, mean_J_list, mean_V_list from the enclosing scope\r\n        func_result = myfunction(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5,mean_Iy_list,mean_J_list)\r\n\r\n\r\n\r\n        displacements = func_result\r\n\r\n        # Define lists for each floor's displacements\r\n        first_floor_displacements = []\r\n        second_floor_displacements = []\r\n        third_floor_displacements = []\r\n\r\n        # Iterate through the displacement sublists and extract displacements for each floor\r\n        for displacement in displacements:\r\n            first_floor_displacements.append(displacement[0])\r\n            second_floor_displacements.append(displacement[1])\r\n            third_floor_displacements.append(displacement[2])\r\n\r\n        # Return all constraints in an array\r\n        return disp_lim - abs(np.array(third_floor_displacements)-np.array(second_floor_displacements))\r\n    \r\n\r\n    limit_state1= ps.LimitState(limit_state_function1)\r\n    limit_state2= ps.LimitState(limit_state_function2)\r\n    limit_state3= ps.LimitState(limit_state_function3)\r\n    # print(\"limit_state\", limit_state)\r\n\r\n\r\n\r\n    # Create a model\r\n    model = ps.StochasticModel()\r\n    \r\n    # Define the random variables\r\n    covs = [0.05] * len(mean_A_list)\r\n\r\n    stdvs_A = [mean * cov for mean, cov in zip(mean_A_list, covs)]\r\n    stdvs_I = [mean * cov for mean, cov in zip(mean_Iz_list, covs)] \r\n\r\n    for i, (mean, stdv) in enumerate(zip(mean_A_list, stdvs_A)):\r\n        model.addVariable(ps.Lognormal(f'X{i}', mean=mean, stdv=stdv))\r\n\r\n    for i, (mean, stdv) in enumerate(zip(mean_Iz_list, stdvs_I)):\r\n        model.addVariable(ps.Lognormal(f'I{i}', mean=mean, stdv=stdv))        \r\n\r\n    # Define mean values for each variable\r\n    mean_P1 = IN[8] # Loads (kN)\r\n    mean_P2 = IN[9]  # Loads (kN)\r\n    mean_P3 = IN[10]  # Loads (kN)\r\n    mean_Wd = IN[11]  # Wind load (kN/m)\r\n    mean_E = IN[4]# Modulus of elasticity in kN/m²\r\n\r\n    # Define Coefficients of Variation (C.O.V.)\r\n    cov_P =  IN[12]  # C.O.V. for P1, P2, P3\r\n    cov_E_Wd =  IN[13]  # C.O.V. for E\r\n    cov_Wd =  IN[14]    # C.O.V. for Wd\r\n\r\n    # Calculate standard deviations based on mean and C.O.V.\r\n    stdv_P1 = cov_P * mean_P1\r\n    stdv_P2 = cov_P * mean_P2\r\n    stdv_P3 = cov_P * mean_P3\r\n    stdv_Wd = cov_Wd * mean_Wd\r\n    stdv_E = cov_E_Wd * mean_E\r\n\r\n    # Update model variable definitions using these variables\r\n    model.addVariable(ps.Lognormal('P1', mean=mean_P1, stdv=stdv_P1))  # Loads (kN)\r\n    model.addVariable(ps.Lognormal('P2', mean=mean_P2, stdv=stdv_P2))  # Loads (kN)\r\n    model.addVariable(ps.Lognormal('P3', mean=mean_P3, stdv=stdv_P3))  # Loads (kN)\r\n    model.addVariable(ps.Normal('Wd', mean=mean_Wd, stdv=stdv_Wd))     # Wind load (kN/m)\r\n    model.addVariable(ps.Lognormal('E', mean=mean_E, stdv=stdv_E))     # Modulus of elasticity (kN/m²)\r\n  \r\n    # Perform reliability analysis using FORM\r\n    analysis = ps.AnalysisOptions()\r\n    analysis.setPrintOutput(False)\r\n    analysis.setStepSize(1)    \r\n    Analysis1 = ps.Form(\r\n        analysis_options=analysis,\r\n        stochastic_model=model,\r\n        limit_state=limit_state1,\r\n    )\r\n    Analysis1.run() # run analysis\r\n    \r\n    # Some single results:\r\n    beta1 = Analysis1.getBeta()\r\n    # Perform reliability analysis using FORM\r\n\r\n \r\n    Analysis2 = ps.Form(\r\n        analysis_options=analysis,\r\n        stochastic_model=model,\r\n        limit_state=limit_state2,\r\n    )\r\n    Analysis2.run() # run analysis\r\n    \r\n    # Some single results:\r\n    beta2 = Analysis2.getBeta()\r\n\r\n        # Perform reliability analysis using FORM\r\n  \r\n    Analysis3 = ps.Form(\r\n        analysis_options=analysis,\r\n        stochastic_model=model,\r\n        limit_state=limit_state3,\r\n    )\r\n    Analysis3.run() # run analysis\r\n    \r\n    # Some single results:\r\n    beta3 = Analysis3.getBeta()\r\n    # Analysis1.showDetailedOutput()\r\n    # Analysis2.showDetailedOutput()\r\n    # Analysis3.showDetailedOutput()\r\n\r\n    betas = [beta1, beta2, beta3]\r\n  \r\n    violance = np.zeros_like(betas)  #\r\n    \r\n    \r\n    for i, beta in enumerate(betas): violance[i] = (beta_allowable[i]-beta  ) / beta_allowable[i]\r\n    \r\n\r\n    return violance\r\n#endregion    \r\n\r\n\r\n\r\n\r\npop_size=IN[15]\r\nn_gen=IN[16]\r\n\r\n\r\n\r\n#region Optimization Problem section    \r\nclass Problem(Problem):\r\n    def __init__(self):\r\n        super().__init__(n_var=6, \r\n                         n_obj=1,\r\n                         n_ieq_constr=3, n_eq_constr=0,\r\n                         xl=np.array([0]*6),  \r\n                         xu=np.array([35,35,35,35,15,15]),\r\n                         vtype=int\r\n                        )\r\n            \r\n\r\n    def _evaluate(self, x, out, *args, **kwargs):\r\n        \r\n        x=x.tolist() \r\n\r\n        x=[[int(i) for i in sublist] for sublist in x]\r\n        Iy_list, Iz_list, A_list, J_list, V_list = excel_call(x)\r\n\r\n        strc_volume=[volume_func(sublist) for sublist in V_list] \r\n\r\n        violance_list = [FORM(sublist_A, sublist_Iz, sublist_Iy,sublist_J) for sublist_A, sublist_Iz, sublist_Iy,sublist_J in zip(A_list, Iz_list, Iy_list, J_list)]\r\n\r\n        # Convert violance_list to an array and handle constraints separately\r\n        violance_array = np.array(violance_list).reshape(-1, 3)  # Separate penalties for each constraint\r\n\r\n        out[\"F\"] = np.column_stack(strc_volume)\r\n        out[\"G\"] = violance_array\r\n\r\n\r\nproblem = Problem()\r\n\r\n# algorithm =  NSGA2(pop_size=30,\r\n#                     sampling=IntegerRandomSampling(),\r\n#                     crossover=SBX(prob=1.0, eta=3.0, vtype=float,repair=RoundingRepair()),\r\n#                     mutation=PM(prob=1.0, eta=3.0, vtype=float,repair=RoundingRepair()),\r\n#                     eliminate_duplicates=True)\r\n# algorithm = GA(pop_size=20,\r\n#                sampling=FloatRandomSampling(),\r\n#                crossover=SBX(prob=1.0, eta=3.0, vtype=float),\r\n#                mutation=PM(prob=1.0, eta=3.0, vtype=float),\r\n#                eliminate_duplicates=True)\r\nfrom pymoo.constraints.eps import AdaptiveEpsilonConstraintHandling\r\nalgorithm = AdaptiveEpsilonConstraintHandling( DE(\r\n    pop_size=pop_size,\r\n    sampling=IntegerRandomSampling(),\r\n    variant=\"DE/rand/1/bin\",\r\n    CR=0.3,\r\n    dither=\"vector\",\r\n    jitter=False\r\n),perc_eps_until=0.25)\r\n\r\n\r\nres = minimize(problem, algorithm,('n_gen', n_gen),verbose=True)\r\n\r\nprint(\"Best solution found:\")\r\nprint(\"Variables:\", res.X)\r\nprint(\"CV\", res.G)\r\n\r\nprint(\"Weight\", res.F)\r\n\r\nprint(\"Execution time: {:.2f} seconds\".format(time.time() - start_time))    \r\n# plot(res.F, )\r\n    \r\n    \r\n\r\n# X1 = np.array([10000, 1001, 10002])\r\n# X2 = np.array([0.1, 0.1, 0.11])\r\n# X3 = 10\r\n# E=np.array([10000, 1001, 10002])\r\n# x=[33.5, 1.62, 22,15.5,1.62,1.8,14.2,19.9,19.9,2.62]\r\n# weight_score = myfunction(X1, X2,E,x)\r\n# print(\"Weight Score:\", weight_score)\r\n \r\n# result=np.array(weight_score)\r\n# print(result)\r\n\r\n\r\n#endregion\r\n\"\"\"\r\n\r\nP1= [133.33    , 133.33    , 133.3    ]\r\nP2 =[266.67     ,266.67    , 266.67   ]\r\nP3= [  400.00, 400.,   400.  ]\r\nE= [ 199947970 , 2.0000e+08, 2.0001e+08]\r\nWd= [ 20.,    20.002, 20.   ]\r\nX0= [0.022774000000000003,   0.02754938, 0.027548  ]\r\nX1= [0.020645,   0.006452,   0.00645232   ]\r\nX2= [0.053742,   0.018774,   0.018774   ]\r\nX3 =[0.033419000000000004,     0.04,     0.04  ]\r\nX4= [0.031484,   0.015742,   0.015742  ]\r\nX5 =[0.013871000000000001,   0.011806,   0.011806 ]\r\nI0= [0.0002060346, 0.00028179, 0.00028179 ]\r\nI1= [0.00018605540000000002, 9.69820000e-06, 9.69820000e-06]\r\nI2= [0.0005993733, 0.00016733, 0.00016733 ]\r\nI3= [0.0003488019, 0.00042872, 0.00042872 ]\r\nI4= [0.0001810607, 3.38812000e-05, 3.38812000e-05 ]\r\nI5 =[2.9385900000000003e-05, 2.39333000e-05, 2.39333000e-05 ]\r\nIy_list= [0.0005743994, 0.000516127, 0.0015983287, 0.0008907353, 0.0017814705, 0.0006659703]\r\nIz_list= [0.0002060346, 0.00018605540000000002, 0.0005993733, 0.0003488019, 0.0001810607, 2.9385900000000003e-05]\r\nJ_list= [0.0007804339000000001, 0.0007021824000000001, 0.0021977019, 0.0012395372, 0.0019625312, 0.0006953562]\r\n# Call the function\r\nx=myfunction(P1, P2, P3, E, Wd, X0, X1, X2, X3, X4, X5, I0, I1, I2, I3, I4, I5,Iy_list,J_list)\r\nprint(\"x\", x)\r\n  \r\n\"\"\"  \r\nsys.stdout.seek(0)\r\nOUT = sys.stdout.read(), res.X\r\n   ",
