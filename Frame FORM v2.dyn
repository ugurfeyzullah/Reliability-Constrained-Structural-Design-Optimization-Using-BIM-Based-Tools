        }
      ],
      "Outputs": [
        {
          "Id": "c6c599e395c74159b9a1e57b2c6901bf",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr  # Required for Python for .NET\r\nimport sys\r\nimport random\r\nimport sys\r\nfrom io import StringIO\r\nsys.stdout = StringIO()\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nimport time\r\nstart_time = time.time()\r\n\r\n# INPUTS\r\n\r\noption=IN[1]\r\nsections=IN[0][1]\r\nbars=IN[2]\r\n\r\nif option == True:\r\n    \r\n    \r\n    print(\"Structure Created on RSA and Analysis have been started\")\r\n\r\n    \r\n    # Load the RSA API library\r\n    clr.AddReference(r'D:\\Programs\\Autodesk\\RSA25\\Robot Structural Analysis Professional 2025\\Exe\\Interop.RobotOM.dll')\r\n    \r\n    # Import the RSA API\r\n    from RobotOM import *\r\n    from System import Object\r\n    \r\n    RobApp= RobotApplicationClass()\r\n    \r\n  ## Dictionary to map unique nodes to their assigned IDs\r\n    unique_nodes = {}\r\n    next_node_id = 1  # Start with the first ID for nodes\r\n    next_bar_id = 1  # Start with the first ID for bars\r\n    \r\n    def round_coords(x, y, z, precision=4):\r\n        return (round(x, precision), round(y, precision), round(z, precision))\r\n    \r\n    # Assign an ID to each unique node\r\n    for bar in bars:\r\n        start_key = round_coords(bar.StartPoint.X, bar.StartPoint.Y, bar.StartPoint.Z)\r\n        end_key = round_coords(bar.EndPoint.X, bar.EndPoint.Y, bar.EndPoint.Z)\r\n    \r\n        # If the start node is unique, assign an ID\r\n        if start_key not in unique_nodes:\r\n            unique_nodes[start_key] = next_node_id\r\n            next_node_id += 1\r\n    \r\n        # If the end node is unique, assign an ID\r\n        if end_key not in unique_nodes:\r\n            unique_nodes[end_key] = next_node_id\r\n            next_node_id += 1\r\n    \r\n    # Now create nodes and bars in RSA\r\n    for bar in bars:\r\n        start_key = round_coords(bar.StartPoint.X, bar.StartPoint.Y, bar.StartPoint.Z)\r\n        end_key = round_coords(bar.EndPoint.X, bar.EndPoint.Y, bar.EndPoint.Z)\r\n    \r\n        # Retrieve the pre-assigned node IDs\r\n        start_node_id = unique_nodes[start_key]\r\n        end_node_id = unique_nodes[end_key]\r\n    \r\n\r\n        # Create the nodes with the assigned IDs\r\n        RobApp.Project.Structure.Nodes.Create(start_node_id, *start_key)\r\n        RobApp.Project.Structure.Nodes.Create(end_node_id, *end_key)\r\n    \r\n        # Create the bar between the nodes\r\n        RobApp.Project.Structure.Bars.Create(next_bar_id, start_node_id, end_node_id)\r\n        next_bar_id += 1  # Increment the bar ID for the next creation\r\n\r\n    \r\n    support_list = IN[3]\r\n    support_type= IN[7]\r\n    FZ= [IN[4],IN[12],IN[13]]\r\n\r\n    num_list = IN[8]\r\n\r\n    result = \" \".join(map(str, num_list))\r\n    direction= IN[9]\r\n    selfw = \"1to\" + str(next_bar_id-1)\r\n    dist_load=IN[14]\r\n    beam_list = [13,14,15,16,17,18,19,20,21]\r\n    \r\n    for i in support_list:\r\n    \r\n        set_node1 = RobApp.Project.Structure.Nodes.Get(i)\r\n        support1= IRobotNode(set_node1)\r\n        support1.SetLabel(IRobotLabelType.I_LT_SUPPORT, support_type)\r\n    \r\n   \r\n   \r\n    \r\n    \r\n    # Create a new simple case\r\n    case_number = RobApp.Project.Structure.Cases.FreeNumber\r\n    cas = RobApp.Project.Structure.Cases.CreateSimple(case_number,\"Case_1\", IRobotCaseNature.I_CN_PERMANENT , IRobotCaseAnalizeType.I_CAT_STATIC_LINEAR )\r\n    \r\n    cas2 = RobApp.Project.Structure.Cases.CreateSimple(case_number+1,\"Case_2\", IRobotCaseNature.I_CN_PERMANENT , IRobotCaseAnalizeType.I_CAT_STATIC_LINEAR )\r\n    \r\n\r\n    case2=cas2.Records.Create(IRobotLoadRecordType.I_LRT_DEAD)\r\n            # Point weight\r\n    # Apply multiple forces at different nodes\r\n    for idx, force in enumerate(FZ):\r\n        case1 = cas.Records.Create(IRobotLoadRecordType.I_LRT_NODE_FORCE)\r\n        load_record = RobotLoadRecord(case1)\r\n        load_record.SetValue(IRobotNodeForceRecordValues.I_NFRV_FX, force*1000)\r\n        \r\n        selection = load_record.get_Objects()\r\n        sel = IRobotSelection(selection)\r\n        sel.FromText(f\"{num_list[idx]}\")  # Apply each force to its corresponding node\r\n        \r\n     \r\n\r\n    case1 = cas2.Records.Create(IRobotLoadRecordType.I_LRT_BAR_UNIFORM)\r\n    load_record = RobotLoadRecord(case1)\r\n    \r\n    # Set the uniform load value in the required direction (assumed here to be Z-direction)\r\n    load_record.SetValue(IRobotUniformRecordValues.I_URV_PZ, -1000*dist_load)\r\n    \r\n    # Apply to the corresponding beam (assuming beam_list contains the beam IDs)\r\n    selection = load_record.get_Objects()\r\n    sel = IRobotSelection(selection)\r\n    sel.FromText(\"13to21\")  # Apply each distributed load to its corresponding beam\r\n        \r\n        \r\n\r\n\r\n    case22=RobotLoadRecord(case2)\r\n    case22.SetValue(IRobotDeadRecordValues.I_DRV_Z,-1)\r\n    selection2 = case22.get_Objects()\r\n    b= IRobotSelection(selection2)\r\n    b.FromText(selfw) \r\n    \r\n\r\n   \r\n   \r\n       \r\n    # Defining Material\r\n    \r\n    # Define the material name\r\n    material_name = \"FrameSteel\"\r\n    \r\n    \r\n    a=RobApp.Project.Structure.Labels\r\n    a=IRobotLabelServer(a)\r\n    \r\n    a=a.Create(IRobotLabelType.I_LT_MATERIAL, material_name)\r\n    \r\n    material = IRobotLabel(a).Data\r\n    \r\n    \r\n    material=IRobotMaterialData(material)\r\n    \r\n    \r\n    \r\n    # Set the material properties\r\n    material.Type = IRobotMaterialType.I_MT_STEEL\r\n    material.E = IN[10]*1000  # Young's modulus in Pascals\r\n    material.NU = 0.33    # Poisson's ratio\r\n    material.RO = IN[11]       # Unit weight in kg/m^3\r\n    material.Kirchoff = material.E / (2 * (1 + material.NU))\r\n    \r\n    s=RobApp.Project.Structure.Labels.Store(a)\r\n        \r\n   \r\n   \r\n   \r\n   \r\n    indexes = sections\r\n    indexes=[ 9.54203486, 15.   ,       2.23629054, 26.688612,    0.38552279, 10.73895709]\r\n    \r\n    \r\n    column_sections = IN[5]\r\n    beam_sections = IN[6]\r\n\r\n    colum_indexes = indexes[:4]\r\n    colum_indexes = [int(x) for x in colum_indexes]\r\n\r\n    beams_indexes = indexes[4:]\r\n    beams_indexes = [int(x) for x in beams_indexes]\r\n    num_list = colum_indexes\r\n    \r\n    selected_columns = [column_sections[i] for i in colum_indexes]\r\n    selected_beams = [beam_sections[i] for i in beams_indexes]\r\n    J_list = selected_columns + selected_beams\r\n    \r\n\r\n    section_names = [J_list[0]] * 2 + [J_list[1]]+ [J_list[2]]*2+ [J_list[3]]+ [J_list[2]]*2+ [J_list[3]]+[J_list[0]]*2+ [J_list[1]]+[J_list[4]]*6+ [J_list[5]]*3\r\n    \r\n    # Assign each section from the list to the corresponding bar\r\n    for i, section_name in enumerate(section_names, start=1):\r\n        # Retrieve the bar using its index\r\n        bar = RobApp.Project.Structure.Bars.Get(i)\r\n        \r\n        # Cast the bar to the IRobotBar type\r\n        bar = IRobotBar(bar)\r\n        \r\n        # Set the section label to the bar\r\n        bar.SetLabel(IRobotLabelType.I_LT_BAR_SECTION, section_name)\r\n        bar.SetLabel(IRobotLabelType.I_LT_MATERIAL ,material_name  )\r\n        bar.SetLabel(IRobotLabelType.I_LT_BAR_RELEASE ,\"Fixed-Fixed\")  \r\n        \r\n        \r\n        \r\n    a=RobApp.Project.get_CalcEngine()\r\n    b=IRobotCalcEngine(a)\r\n    b.Calculate()\r\n\r\n    Save=RobApp.Kernel\r\n    b=IRobotKernel(Save)\r\n    b.ProjectSaveAs(r'C:\\Users\\ugury\\OneDrive\\Masaüstü\\Test1.rtd')\r\n    \r\n    \r\n\r\nelse:\r\n    print(\"The option is not selected\")\r\n\r\n\r\nsys.stdout.seek(0)\r\nOUT = sys.stdout.read()\r\n\r\n    \r\n    \r\n \r\n\r\n\r\n\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
